{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryaprasanthcse/kintsugi-omega/schemas/E5_sabotage_commitment.schema.json",
  "title": "E.5 Sabotage commitment record",
  "description": "The public record committed before delivery: c = SHA-256(JCS(spec) ‖ salt). It must reveal nothing about the fault: only a coarse class family (spec §7.2, Appendix E.5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "c", "sealed_at", "not_before", "class_family"],
  "properties": {
    "id": {"type": "string", "pattern": "^S-[0-9]+$"},
    "c": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sealed_at": {"type": "string", "minLength": 1},
    "not_before": {"type": "string", "minLength": 1},
    "class_family": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)*$",
      "description": "the catalog class without its last component, e.g. code.regression"
    },
    "attestation": {"type": "string", "pattern": "^(ed25519|ecdsa-p256):[A-Za-z0-9+/=]+$"}
  }
}
