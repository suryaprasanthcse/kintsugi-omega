{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suryaprasanthcse/kintsugi-omega/schemas/E4_repair_receipt.schema.json",
  "title": "E.4 Repair receipt (PR body) variables",
  "description": "The variables rendered into E4_repair_receipt.template.md (spec Appendix E.4). The spec's prose placeholders are normalised to identifiers: {one-paragraph description} → fix_description, {AB@ver or \"primary\"} → antibody, the two {ci} → ci_before/ci_after, the two {links} → trace_links_before/trace_links_after, {attempts incl. failed} → checkpoints. The gate line is static: a PR is only opened when G0–G7 all pass (invariant I1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "INC", "symptom_summary", "host", "t_detect", "t_resolve", "suspects", "ck", "quoted_intent",
    "fix_description", "antibody", "p_before", "ci_before", "p_after", "ci_after", "p",
    "c_before", "c_after", "cost_ub", "l_before", "l_after", "p95_ub", "ci_url",
    "trace_links_before", "trace_links_after", "checkpoints", "cost", "budget", "plan_sha",
    "seq", "h", "issue"
  ],
  "properties": {
    "INC": {"type": "string", "pattern": "^INC-"},
    "symptom_summary": {"type": "string", "maxLength": 800},
    "host": {"type": "string"},
    "t_detect": {"type": "string"},
    "t_resolve": {"type": "string"},
    "suspects": {"type": "string"},
    "ck": {"type": "string"},
    "quoted_intent": {"type": "string", "maxLength": 300},
    "fix_description": {"type": "string"},
    "antibody": {"type": "string", "description": "AB-n@version, or \"primary\""},
    "p_before": {"type": "string"},
    "ci_before": {"type": "string"},
    "p_after": {"type": "string"},
    "ci_after": {"type": "string"},
    "p": {"type": "string"},
    "c_before": {"type": "string"},
    "c_after": {"type": "string"},
    "cost_ub": {"type": "string"},
    "l_before": {"type": "string"},
    "l_after": {"type": "string"},
    "p95_ub": {"type": "string"},
    "ci_url": {"type": "string"},
    "trace_links_before": {"type": "string"},
    "trace_links_after": {"type": "string"},
    "checkpoints": {"type": "string", "description": "every attempt, failed ones included"},
    "cost": {"type": "string"},
    "budget": {"type": "string"},
    "plan_sha": {"type": "string"},
    "seq": {"type": "integer", "minimum": 1},
    "h": {"type": "string"},
    "issue": {"type": "integer", "minimum": 1}
  }
}
