# Secrets and credentials — never commit
.env
*.csv
*accessKeys*
*credentials*
*.key
*.age
# Sealed holdouts are encrypted to .kintsugi/holdout.pub and committed (spec §6.1, audit C13).
!hosts/*/*/evals/holdout/*.age

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
dist/
build/

# Node
node_modules/

# Allow the business-plan actuals export (spec §4.6.5)
!business/actuals.csv

# Re-assert after the exception: secrets stay ignored everywhere, business/ included
*accessKeys*
*credentials*
